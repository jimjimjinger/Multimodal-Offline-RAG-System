<mxfile host="app.diagrams.net">
  <diagram id="g4reranking" name="G4_ReRanking">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="G4 Context-Aware Re-ranking Process" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="G4 is a re-ranking layer on top of G3 candidates. It adjusts candidate scores using estimated practice-stage context." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=13;align=center" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="940" height="44" as="geometry" />
